diff --git a/include/linux/vq_turbo.h b/include/linux/vq_turbo.h
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/include/linux/vq_turbo.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_VQ_TURBO_H
+#define _LINUX_VQ_TURBO_H
+
+#include <linux/sched.h>
+#include <linux/types.h>
+
+struct vq_stats {
+	u64 enqueue_cnt;
+	u64 dequeue_cnt;
+	u64 pick_cnt;
+	u64 migrate_cnt;
+	u64 turbo_boost_hits;
+};
+
+extern int sysctl_vq_turbo_enabled;
+extern int sysctl_vq_num_cores;
+extern int sysctl_vq_boost_percent;
+extern int sysctl_vq_timeslice_ns;
+
+void vq_turbo_init(void);
+void vq_turbo_tick(struct rq *rq, struct task_struct *p, int queued);
+bool task_is_vq_turbo(struct task_struct *p);
+
+int proc_vq_turbo_init(void);
+
+#endif
+
diff --git a/kernel/sched/Kconfig b/kernel/sched/Kconfig
index 08c8f7a11111..08c8f7a22222 100644
--- a/kernel/sched/Kconfig
+++ b/kernel/sched/Kconfig
@@ -120,6 +120,16 @@ config SCHED_CORE
 
 endchoice
 
+config SCHED_VQ_TURBO
+	bool "Virtual Qubit Turbo scheduling policy"
+	default y
+	help
+	  Adds an experimental scheduler policy SCHED_VQ_TURBO intended for
+	  virtual-qubit simulation workloads. Tasks with this policy are managed
+	  by a dedicated scheduler class that favors low-latency quantum-like
+	  vector stages and configurable turbo boosting.
+
+
 config UCLAMP_TASK
 	bool "Enable utilization clamping for RT/FAIR tasks"
 	depends on CPU_FREQ_GOV_SCHEDUTIL
