+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_VQ_TURBO_H
+#define _LINUX_VQ_TURBO_H
+
+#include <linux/sched.h>
+#include <linux/types.h>
+
+struct vq_stats {
+	u64 enqueue_cnt;
+	u64 dequeue_cnt;
+	u64 pick_cnt;
+	u64 migrate_cnt;
+	u64 preempt_cnt;
+	u64 turbo_boost_hits;
+};
+
+extern int sysctl_vq_turbo_enabled;
+extern int sysctl_vq_num_cores;
+extern int sysctl_vq_boost_percent;
+extern int sysctl_vq_timeslice_ns;
+
+bool task_is_vq_turbo(struct task_struct *p);
+void vq_turbo_task_fork(struct task_struct *p);
+int proc_vq_turbo_init(void);
+
+#endif
