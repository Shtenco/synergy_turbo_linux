diff --git a/kernel/sched/vq_turbo.c b/kernel/sched/vq_turbo.c
new file mode 100644
index 000000000000..222222222222
--- /dev/null
+++ b/kernel/sched/vq_turbo.c
@@ -0,0 +1,301 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/sched.h>
+#include <linux/sched/clock.h>
+#include <linux/sched/topology.h>
+#include <linux/smp.h>
+#include <linux/spinlock.h>
+#include <linux/slab.h>
+#include <linux/sysctl.h>
+#include <linux/vq_turbo.h>
+
+int sysctl_vq_turbo_enabled = 1;
+int sysctl_vq_num_cores = 8;
+int sysctl_vq_boost_percent = 35;
+int sysctl_vq_timeslice_ns = 2000000;
+
+static struct vq_stats global_vq_stats;
+
+struct vq_rq {
+	struct list_head queue;
+	unsigned int nr_running;
+	u64 exec_clock;
+};
+
+static inline struct vq_rq *vq_rq_of(struct rq *rq)
+{
+	return (struct vq_rq *)&rq->cfs; /* placeholder storage for out-of-tree patch */
+}
+
+bool task_is_vq_turbo(struct task_struct *p)
+{
+	return p->policy == SCHED_VQ_TURBO;
+}
+
+static void enqueue_task_vq_turbo(struct rq *rq, struct task_struct *p, int flags)
+{
+	struct vq_rq *vrq = vq_rq_of(rq);
+
+	if (!sysctl_vq_turbo_enabled)
+		return;
+
+	if (list_empty(&p->se.group_node)) {
+		list_add_tail(&p->se.group_node, &vrq->queue);
+		vrq->nr_running++;
+		global_vq_stats.enqueue_cnt++;
+	}
+}
+
+static void dequeue_task_vq_turbo(struct rq *rq, struct task_struct *p, int flags)
+{
+	struct vq_rq *vrq = vq_rq_of(rq);
+
+	if (!list_empty(&p->se.group_node)) {
+		list_del_init(&p->se.group_node);
+		if (vrq->nr_running)
+			vrq->nr_running--;
+		global_vq_stats.dequeue_cnt++;
+	}
+}
+
+static struct task_struct *pick_next_task_vq_turbo(struct rq *rq)
+{
+	struct vq_rq *vrq = vq_rq_of(rq);
+	struct task_struct *p;
+
+	if (!sysctl_vq_turbo_enabled || !vrq->nr_running)
+		return NULL;
+
+	p = list_first_entry(&vrq->queue, struct task_struct, se.group_node);
+	global_vq_stats.pick_cnt++;
+	return p;
+}
+
+static void put_prev_task_vq_turbo(struct rq *rq, struct task_struct *p)
+{
+	/* round-robin within VQ class */
+	if (!list_empty(&p->se.group_node)) {
+		list_move_tail(&p->se.group_node, &vq_rq_of(rq)->queue);
+	}
+}
+
+static void task_tick_vq_turbo(struct rq *rq, struct task_struct *curr, int queued)
+{
+	u64 slice = (u64)sysctl_vq_timeslice_ns;
+
+	if (!task_is_vq_turbo(curr))
+		return;
+
+	vq_turbo_tick(rq, curr, queued);
+
+	if ((u64)curr->se.sum_exec_runtime > slice) {
+		resched_curr(rq);
+		curr->se.sum_exec_runtime = 0;
+	}
+}
+
+void vq_turbo_tick(struct rq *rq, struct task_struct *p, int queued)
+{
+	if (!sysctl_vq_turbo_enabled)
+		return;
+
+	/* simple synthetic turbo boost accounting */
+	if ((rq->clock_task & 0xF) < (u64)(sysctl_vq_boost_percent / 10))
+		global_vq_stats.turbo_boost_hits++;
+}
+
+static int select_task_rq_vq_turbo(struct task_struct *p, int cpu, int flags)
+{
+	int target = cpu;
+
+	if (sysctl_vq_num_cores > 0)
+		target = cpumask_any(cpu_online_mask);
+
+	if (target != cpu)
+		global_vq_stats.migrate_cnt++;
+
+	return target;
+}
+
+static void switched_to_vq_turbo(struct rq *rq, struct task_struct *p)
+{
+	if (task_on_rq_queued(p))
+		resched_curr(rq);
+}
+
+static unsigned int get_rr_interval_vq_turbo(struct rq *rq, struct task_struct *task)
+{
+	return nsecs_to_jiffies((u64)sysctl_vq_timeslice_ns);
+}
+
+DEFINE_SCHED_CLASS(vq_turbo) = {
+	.enqueue_task		= enqueue_task_vq_turbo,
+	.dequeue_task		= dequeue_task_vq_turbo,
+	.pick_next_task		= pick_next_task_vq_turbo,
+	.put_prev_task		= put_prev_task_vq_turbo,
+	.task_tick		= task_tick_vq_turbo,
+	.select_task_rq		= select_task_rq_vq_turbo,
+	.switched_to		= switched_to_vq_turbo,
+	.get_rr_interval		= get_rr_interval_vq_turbo,
+};
+
+static int vq_turbo_proc_show(struct seq_file *m, void *v)
+{
+	seq_printf(m, "enabled: %d\n", sysctl_vq_turbo_enabled);
+	seq_printf(m, "vq_num_cores: %d\n", sysctl_vq_num_cores);
+	seq_printf(m, "timeslice_ns: %d\n", sysctl_vq_timeslice_ns);
+	seq_printf(m, "boost_percent: %d\n", sysctl_vq_boost_percent);
+	seq_printf(m, "enqueue: %llu\n", global_vq_stats.enqueue_cnt);
+	seq_printf(m, "dequeue: %llu\n", global_vq_stats.dequeue_cnt);
+	seq_printf(m, "pick: %llu\n", global_vq_stats.pick_cnt);
+	seq_printf(m, "migrate: %llu\n", global_vq_stats.migrate_cnt);
+	seq_printf(m, "turbo_boost_hits: %llu\n", global_vq_stats.turbo_boost_hits);
+	return 0;
+}
+
+static int vq_turbo_proc_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, vq_turbo_proc_show, NULL);
+}
+
+static const struct proc_ops vq_turbo_proc_ops = {
+	.proc_open	= vq_turbo_proc_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+};
+
+int proc_vq_turbo_init(void)
+{
+	if (!proc_create("vq_turbo", 0444, NULL, &vq_turbo_proc_ops))
+		return -ENOMEM;
+	return 0;
+}
+
+void vq_turbo_init(void)
+{
+	memset(&global_vq_stats, 0, sizeof(global_vq_stats));
+	proc_vq_turbo_init();
+}
+
+static int __init vq_turbo_module_init(void)
+{
+	vq_turbo_init();
+	pr_info("VQ Turbo scheduler initialized\n");
+	return 0;
+}
+early_initcall(vq_turbo_module_init);
diff --git a/kernel/sched/core.c b/kernel/sched/core.c
index 228f2a111111..228f2a222222 100644
--- a/kernel/sched/core.c
+++ b/kernel/sched/core.c
@@ -88,6 +88,7 @@
 #include <linux/sched/deadline.h>
 #include <linux/sched/rt.h>
 #include <linux/sched/task.h>
+#include <linux/vq_turbo.h>
 
 #include "sched.h"
 
@@ -4639,6 +4640,10 @@ static void __sched notrace __schedule(unsigned int sched_mode)
 	if (sched_class_above(prev->sched_class, &fair_sched_class) &&
 	    rt_rq_is_runnable(&rq->rt))
 		next = pick_next_task_rt(rq, prev, &rf);
+	else if (prev->policy == SCHED_VQ_TURBO ||
+		     (sysctl_vq_turbo_enabled && likely(rq->nr_running)))
+		next = vq_turbo_sched_class.pick_next_task(rq);
+
 	if (!next)
 		next = pick_next_task_fair(rq, prev, &rf);
@@ -7210,6 +7215,14 @@ int sched_setscheduler_nocheck(struct task_struct *p, int policy,
 		policy = SCHED_NORMAL;
 	}
 
+	if (policy == SCHED_VQ_TURBO) {
+		if (!sysctl_vq_turbo_enabled)
+			return -EPERM;
+		if (!IS_ENABLED(CONFIG_SCHED_VQ_TURBO))
+			return -EINVAL;
+		p->sched_class = &vq_turbo_sched_class;
+	}
+
 	return __sched_setscheduler(p, policy, param, true);
 }
